# Copy this file to ".env" (exactly that name) and fill in the values. Save the file after editing.
# A value that contains # must be wrapped in double quotes, for example: ADMIN_PASSWORD="abc#12345"
# Without the quotes, everything from the # onward is ignored.
# Never share or commit your real .env file.

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# The address of the Angular app. Used for CORS and for password reset links.
FRONTEND_URL=http://localhost:4200

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acadsync
DB_USER=postgres
DB_PASSWORD=
# Set to true only when your database host requires SSL (for example Neon or Render).
DB_SSL=false
# Optional: one connection string instead of the DB_* values above.
# DATABASE_URL=

# Database used by "npm test". It is created automatically and wiped on every test run.
TEST_DB_NAME=acadsync_test

# ---------- Sign-in sessions ----------
# A long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------- Admin accounts (used only by "npm run seed") ----------
# Passwords need at least 8 characters with a letter and a number.
SUPER_USER_NAME=
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Email (optional) ----------
# Leave SMTP_HOST empty during local development:
# password reset links are then printed in the backend console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AcadSync <no-reply@example.com>

# ---------- Security ----------
# Sign-in and password reset requests allowed per 15 minutes from one address.
AUTH_RATE_LIMIT_MAX=30
# Set to 1 when the API runs behind a proxy (for example Render).
TRUST_PROXY=0

# ---------- Billing (optional, these are the defaults) ----------
# Timezone used for "today", due dates and reports.
APP_TIMEZONE=Asia/Manila
# Days a teacher has to pay an invoice before the subscription expires.
INVOICE_DUE_DAYS=7
# Folder (inside backend) for uploaded payment screenshots and the payment QR code.
UPLOAD_DIR=uploads
